  {
    "id": "rails",
    "label": "Ruby (Rails)",
    "build_context": "petshop-stacks/ruby/rails",
    "dockerfile": "Dockerfile",
    "dockerfile_optimized": "Dockerfile.optimized",
    "db_name": "ruby-rails",
    "host_port": 8099,
    "host_port_optimized": 8100,
    "base_path": "/api/v3",
    "readiness_path": "/api/v3/pet/findByStatus?status=available",
    "entrypoint_override": "bin/rails",
    "cmd_override": ["server", "-b", "0.0.0.0", "-p", "8080"],
    "env": {
      "RAILS_ENV": "development",
      "RAILS_ALLOWED_HOSTS": "localhost,.local,speed-test-app-rails-naive,speed-test-app-rails-optimized,.docker.internal,.*",
      "POSTGRES_HOST": "speed-test-postgres",
      "POSTGRES_PORT": "5432",
      "POSTGRES_USER": "myuser",
      "POSTGRES_PASSWORD": "mypassword",
      "POSTGRES_DB": "ruby-rails"
    },
    "env_optimized": {
      "RAILS_ENV": "production"
    },
    "notes": "Naive stays RAILS_ENV=development; optimized runs RAILS_ENV=production (via env_optimized) with eager loading — the generated ActionCable/ActiveJob/ActionMailer/ActiveRecord stubs that crashed production eager loading were removed from the app. SECRET_KEY_BASE comes from the RAILS_SECRET_KEY_BASE injection run.sh already does. entrypoint_override bypasses docker-entrypoint.sh which calls db:migrate (fails without ActiveRecord)."
  },
