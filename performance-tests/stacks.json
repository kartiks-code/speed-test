  {
    "id": "rails",
    "label": "Ruby (Rails)",
    "build_context": "ruby/rails",
    "dockerfile": "Dockerfile",
    "dockerfile_optimized": "Dockerfile.optimized",
    "db_name": "ruby-rails",
    "base_path": "/api/v3",
    "readiness_path": "/api/v3/pet/findByStatus?status=available",
    "entrypoint_override": "bin/rails",
    "cmd_override": ["server", "-b", "0.0.0.0", "-p", "8080"],
    "env": {
      "RAILS_ENV": "development",
      "RAILS_ALLOWED_HOSTS": "localhost,.local,speed-test-app-rails-naive,speed-test-app-rails-optimized,.docker.internal,.*",
      "POSTGRES_HOST": "speed-test-postgres",
      "POSTGRES_PORT": "5432",
      "POSTGRES_USER": "myuser",
      "POSTGRES_PASSWORD": "mypassword",
      "POSTGRES_DB": "ruby-rails"
    },
    "notes": "Uses RAILS_ENV=development to avoid ActionCable eager-load error in the generated production config. entrypoint_override bypasses docker-entrypoint.sh which calls db:migrate (fails without ActiveRecord). Dockerfile.optimized already sets CMD directly and uses production — it may still fail on ActionCable; handled via same entrypoint_override."
  },
