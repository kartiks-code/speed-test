# Stage 1: restore NuGet packages (cached when .csproj unchanged)
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src
COPY ["src/Petstore/Petstore.csproj", "Petstore/"]
RUN dotnet restore "Petstore/Petstore.csproj"

COPY src/Petstore/ Petstore/
WORKDIR "Petstore"
RUN dotnet publish "Petstore.csproj" \
      -c Release \
      -o /app/publish \
      --no-restore

# Stage 2: minimal ASP.NET runtime image (Alpine — ~100 MB vs ~200 MB Debian slim)
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS runtime

# Alpine images ship without ICU; needed because invariant globalization is disabled
RUN apk add --no-cache icu-libs icu-data-full

RUN adduser -D -H -s /bin/false -u 1001 dotnet

WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Production env + warning-level logging cut per-request console overhead.
# Pool 200 handles up to 500 k6 VUs via queueing under Postgres max_connections=500.
ENV ASPNETCORE_ENVIRONMENT=Production \
    Logging__LogLevel__Default=Warning \
    Logging__LogLevel__Microsoft.AspNetCore=Warning \
    PG_MAX_POOL_SIZE=200

USER dotnet

EXPOSE 8080

ENTRYPOINT ["dotnet", "Petstore.dll"]
