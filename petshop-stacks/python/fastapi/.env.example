# Database connection — copy to .env and fill in your values.
# All vars are optional; defaults match the shared database/.env setup.

# Option A: full DSN (takes precedence over individual vars below)
# DATABASE_URL=postgresql://myuser:mypassword@localhost:5434/python-fastapi

# Option B: individual vars
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=python-fastapi

# asyncpg pool sizing (optional)
# ASYNCPG_POOL_MIN_SIZE=1
# ASYNCPG_POOL_MAX_SIZE=10
