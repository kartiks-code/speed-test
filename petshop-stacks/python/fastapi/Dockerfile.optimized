# Stage 1: install dependencies into an isolated venv
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

# Dependencies first so source-only changes don't re-resolve them
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml setup.cfg ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

# Stage 2: minimal runtime — no build tools
FROM python:3.12-slim AS runtime

RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --gid 1001 appuser

COPY --from=builder /venv /venv
ENV PATH="/venv/bin:$PATH"

# Prevent .pyc writes and enable unbuffered stdout for container logs
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app

COPY --chown=appuser:appgroup src ./src

USER appuser

EXPOSE 8080

# 2 workers matches the harness --cpus 2 limit; 2 workers x 100 pool max = 200 DB
# connections, which handles up to 500 VUs via pool queueing well under Postgres
# max_connections=500. Override via env at runtime.
ENV WEB_CONCURRENCY=2 ASYNCPG_POOL_MAX_SIZE=100

# sh -c so ${WEB_CONCURRENCY} expands; exec replaces the shell as PID 1
CMD ["sh", "-c", "exec uvicorn petstore.main:app --host 0.0.0.0 --port 8080 --workers ${WEB_CONCURRENCY:-2} --no-access-log --log-level warning"]
