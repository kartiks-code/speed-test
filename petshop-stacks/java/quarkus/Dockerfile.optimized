# Stage 1: build the fast-jar with a build-time AppCDS archive.
# Alpine JDK so the CDS archive is generated by the exact same Temurin/musl
# JVM family as the Alpine JRE runtime stage (CDS archives are rejected on a
# JVM mismatch and the JVM silently falls back to non-shared class loading).
FROM eclipse-temurin:25-jdk-alpine AS build

# Install Gradle wrapper dependencies first for layer caching
WORKDIR /app
COPY gradlew .
COPY gradle ./gradle
COPY build.gradle settings.gradle gradle.properties ./
RUN ./gradlew dependencies -q 2>/dev/null || true

COPY src ./src
# Override the repo-wide uber-jar packaging (gradle.properties) with fast-jar
# and let Quarkus generate the AppCDS archive at build time (app-cds.jsa).
# aot.type=app-cds forces classic AppCDS — NOT Leyden AOT (-XX:AOTCache),
# which deadlocks virtual threads with Agroal under Docker CPU limits.
RUN ./gradlew build -x test -q \
    -Dquarkus.package.jar.type=fast-jar \
    -Dquarkus.package.jar.aot.enabled=true \
    -Dquarkus.package.jar.aot.type=app-cds

# Stage 2: Alpine runtime.  Must be the SAME image as the build stage: the
# Quarkus-generated app-cds.jsa is a *dynamic* CDS archive layered on the
# JVM's base archive (lib/server/classes.jsa), and the jlink'd -jre-alpine
# image ships a different base archive, which fails the static archive
# checksum check and disables CDS entirely.
FROM eclipse-temurin:25-jdk-alpine AS runtime

RUN addgroup -S quarkus && adduser -S quarkus -G quarkus

WORKDIR /app

# fast-jar layout in cache-friendly order: third-party libs change rarely,
# Quarkus internals occasionally, application code most often.
COPY --from=build /app/build/quarkus-app/lib/ ./lib/
COPY --from=build /app/build/quarkus-app/quarkus/ ./quarkus/
COPY --from=build /app/build/quarkus-app/app/ ./app/
COPY --from=build /app/build/quarkus-app/quarkus-run.jar ./
COPY --from=build /app/build/quarkus-app/app-cds.jsa ./

USER quarkus

EXPOSE 8080

# WARN-level logging cuts per-request log overhead under benchmark load.
ENV QUARKUS_LOG_LEVEL=WARN

# Quarkus fast-jar with AppCDS for faster class loading.  G1GC with
# container-aware heap sizing; urandom avoids SecureRandom blocking.
# AppCDS requires the same JAR/archive relative paths as at generation time,
# hence WORKDIR /app mirroring the quarkus-app directory layout.
ENTRYPOINT ["java", \
  "-XX:InitialRAMPercentage=75.0", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:+UseG1GC", \
  "-XX:+OptimizeStringConcat", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-XX:SharedArchiveFile=app-cds.jsa", \
  "-jar", "quarkus-run.jar"]
