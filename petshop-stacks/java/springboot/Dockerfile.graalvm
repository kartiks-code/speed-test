# Spring Boot GraalVM native-image build.
#
# Spring Boot 3.5 has solid native image support via Spring AOT processing
# (JEP 483 + spring-boot-starter-parent managed native-maven-plugin). All
# components used here have native image metadata:
#   - JdbcTemplate / HikariCP  (spring-boot-autoconfigure AOT hints)
#   - Jackson (jackson-databind native-image metadata bundled since 2.15)
#   - springdoc-openapi 2.x    (native hints added in 2.3+)
#   - Virtual threads          (SubstrateVM Loom support since GraalVM 21)
#
# Build time: 5–10 min.
# Startup:    < 100 ms.
# Memory:     ~80–120 MB RSS.
#
# The pom.xml native profile (id=native) activates the native-maven-plugin.
# GraalVM CE JDK is required in the build stage (not Temurin) because Spring
# AOT processing must run under the same JDK that compiles the native binary.

# ── Stage 1: resolve Maven dependencies ─────────────────────────────────────
# Use GraalVM CE 25 as the build JDK so both the AOT compilation step and the
# native-image step share the same JVM — Spring Boot requires this.
FROM ghcr.io/graalvm/native-image-community:25 AS deps

ARG MAVEN_VERSION=3.9.9
# Install Maven into the GraalVM image (not pre-installed in the base).
RUN microdnf install -y tar gzip findutils && \
    curl -sL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
        | tar -xz -C /opt && \
    ln -s "/opt/apache-maven-${MAVEN_VERSION}/bin/mvn" /usr/local/bin/mvn

WORKDIR /app
COPY pom.xml .
# Resolve both compile-scope and native-profile deps in one layer.
RUN mvn dependency:go-offline -Pnative -q

# ── Stage 2: AOT processing + native-image compilation ──────────────────────
FROM deps AS build

COPY src ./src

# Spring Boot AOT generates proxy/reflection metadata, then native-image
# compiles the full application into a self-contained binary.
# SpringDoc is disabled: its swagger-ui webjars are not needed in benchmarks
# and excluding them keeps the binary smaller.
RUN mvn -Pnative native:compile -DskipTests -q \
    -Dspringdoc.swagger-ui.enabled=false \
    -Dspringdoc.api-docs.enabled=false

# ── Stage 3: minimal runtime — native binary, no JRE required ───────────────
FROM debian:12-slim AS runtime

RUN groupadd -r spring && useradd -r -g spring spring

WORKDIR /app
COPY --from=build /app/target/petstore-server ./petstore-server
RUN chown spring:spring ./petstore-server

USER spring:spring

EXPOSE 8080

# Spring Boot native binaries accept properties via --key=value args or env vars.
ENTRYPOINT ["./petstore-server", \
  "--logging.level.root=WARN", \
  "--springdoc.swagger-ui.enabled=false", \
  "--springdoc.api-docs.enabled=false"]
