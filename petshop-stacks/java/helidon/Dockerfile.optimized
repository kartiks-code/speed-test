# Stage 1: dependency cache — only re-runs when pom.xml changes
FROM maven:3.9-eclipse-temurin-25-alpine AS deps
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -q

# Stage 2: build
FROM deps AS build
COPY src ./src
RUN mvn package -DskipTests -q

# Stage 3: Leyden AOT training (JDK 25, JEP 483)
# -XX:AOTMode=record -XX:AOTCacheOutput automatically spawns a child JVM on exit
# to assemble the cache — no separate create phase needed.
# Helidon starts and CDI/JAX-RS classes are loaded; HikariCP fails fast
# (initializationFailTimeout=1 ms default) because there is no database in the
# build environment, causing a clean JVM exit whose shutdown hooks record the
# class-loading profile and build the AOT cache.  SIGTERM after 10 s catches
# any case where the app starts successfully (e.g. network-accessible DB).
FROM eclipse-temurin:25-jre-alpine AS training
WORKDIR /app
COPY --from=build /app/target/petstore-helidon.jar app.jar
COPY --from=build /app/target/libs libs
RUN touch app.aot
RUN java \
  -XX:MaxRAMPercentage=75.0 \
  -XX:+UseG1GC \
  -Djava.security.egd=file:/dev/./urandom \
  -XX:AOTMode=record \
  -XX:AOTCacheOutput=app.aot \
  -jar app.jar & \
  APP_PID=$! && sleep 10 && kill -TERM "$APP_PID" 2>/dev/null; wait "$APP_PID" 2>/dev/null || true

# Stage 4: minimal runtime image with Java 25 virtual-thread-capable JRE
FROM eclipse-temurin:25-jre-alpine AS runtime

RUN addgroup -S helidon && adduser -S helidon -G helidon

WORKDIR /app

COPY --from=build /app/target/petstore-helidon.jar app.jar
COPY --from=build /app/target/libs libs
COPY --from=training /app/app.aot ./

USER helidon:helidon

EXPOSE 8080

# G1GC is used because the container heap is small (~384MB under the 512MB
# limit at MaxRAMPercentage=75); at that size G1 is more memory-efficient and
# lower-overhead than ZGC.  MaxRAMPercentage caps heap at 75% of cgroup memory.
ENTRYPOINT ["java", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:+UseG1GC", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-XX:AOTCache=app.aot", \
  "-jar", "app.jar"]
