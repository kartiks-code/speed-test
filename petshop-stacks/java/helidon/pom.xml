<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <parent>
        <groupId>io.helidon.applications</groupId>
        <artifactId>helidon-mp</artifactId>
        <version>4.4.1</version>
        <relativePath/>
    </parent>
    <artifactId>petstore-helidon</artifactId>
    <name>petstore-helidon</name>
        <description>This is a sample Pet Store Server based on the OpenAPI 3.1 specification.  You can find out more about Swagger at [https://swagger.io](https://swagger.io). In the third iteration of the pet store, we&#39;ve switched to the design first approach! You can now help us improve the API whether it&#39;s by making changes to the definition itself or to the code. That way, with time, we can improve the API in general, and expose some of the new features in OAS3.  Some useful links: - [The Pet Store repository](https://github.com/swagger-api/swagger-petstore) - [The source API definition for the Pet Store](https://github.com/swagger-api/swagger-petstore/blob/master/src/main/resources/openapi.yaml)</description>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <version.jackson.databind.nullable>0.2.10</version.jackson.databind.nullable>
        <!-- Helidon 4 baseline is JDK 21; JDK 25 is recommended. Parent derives
             maven.compiler.target/release from maven.compiler.source. -->
        <maven.compiler.source>25</maven.compiler.source>
    </properties>

    <!-- GraalVM native-image profile: mvn -Pnative-image package -DskipTests -->
    <profiles>
        <profile>
            <id>native-image</id>
            <dependencies>
                <!-- Helidon 4 native-image support: CDI/JAX-RS reflection configs,
                     resource registrations, and SubstrateVM initialisation hooks. -->
                <dependency>
                    <groupId>io.helidon.integrations.graal</groupId>
                    <artifactId>helidon-graal-native-image-extension</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.5</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>petstore-helidon</imageName>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-O2</buildArg>
                                <!--
                                  Jersey's JacksonJsonProvider holds a static jackson-core
                                  Version object; GraalVM requires it to be build-time init.
                                  Weld CDI scanning during analysis touches these classes
                                  before Jackson declares its own init policy, so we force
                                  build-time init for the Jackson version infrastructure.
                                -->
                                <buildArg>--initialize-at-build-time=com.fasterxml.jackson.core.Version</buildArg>
                                <buildArg>--initialize-at-build-time=com.fasterxml.jackson.core.util.VersionUtil</buildArg>
                                <buildArg>--initialize-at-build-time=com.fasterxml.jackson.databind.cfg.PackageVersion</buildArg>
                                <buildArg>--initialize-at-build-time=com.fasterxml.jackson.datatype.jsr310.PackageVersion</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>io.helidon.microprofile.bundles</groupId>
            <artifactId>helidon-microprofile-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>
        <dependency>
            <groupId>io.helidon.microprofile.cdi</groupId>
            <artifactId>helidon-microprofile-cdi</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${version.jackson.databind.nullable}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.microprofile.testing</groupId>
            <artifactId>helidon-microprofile-testing-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
        <!-- CRaC: enables HikariCP 5.x built-in beforeCheckpoint/afterRestore hooks
             for Dockerfile.crac.  jcmd triggers the checkpoint externally via
             crac-checkpoint.sh; this library wires the pool lifecycle to CRaC events. -->
        <dependency>
            <groupId>org.crac</groupId>
            <artifactId>crac</artifactId>
            <version>1.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                    </execution>
                </executions>
            </plugin>
            <!--
                Mutation testing with PIT.
                Run with:  mvn test-compile org.pitest:pitest-maven:mutationCoverage
                Only the hand-written service-impl and repository classes are targeted;
                generated model/interface/scaffolding code is excluded.
                The unit tests (PetServiceImplTest etc.) are pure Mockito and do not
                start a CDI container, so PIT instruments them without issues.
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.25.4</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>org.openapitools.server.api.*ServiceImpl</param>
                        <param>org.openapitools.server.db.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>org.openapitools.server.*</param>
                    </targetTests>
                    <outputFormats>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <failWhenNoMutations>false</failWhenNoMutations>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
