# Stage 1: cache module downloads separately from source
FROM golang:1.25-alpine AS deps
WORKDIR /go/src
COPY go.mod go.sum ./
RUN go mod download

# Stage 2: build a statically linked binary with debug info stripped
FROM deps AS build
COPY go ./go
COPY main.go .
ENV CGO_ENABLED=0
RUN go build \
      -ldflags="-w -s" \
      -trimpath \
      -o petstore .

# Stage 3: scratch — zero-OS image, only the binary + TLS CA bundle
FROM scratch AS runtime
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /go/src/petstore ./
ENV GIN_MODE=release
# Benchmark tuning: pool of 200 handles up to 500 k6 VUs via queueing while
# staying under Postgres max_connections=500; GOMEMLIMIT aligns the Go GC with
# the harness's 512m container memory limit.
ENV GIN_DISABLE_REQUEST_LOGGING=true GOMEMLIMIT=460MiB DB_MAX_OPEN_CONNS=200 DB_MAX_IDLE_CONNS=50
USER 65534:65534
EXPOSE 8080/tcp
ENTRYPOINT ["./petstore"]
