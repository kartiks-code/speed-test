# Stage 1: cache module downloads separately from source
FROM golang:1.25-alpine AS deps
WORKDIR /go/src
COPY go.mod go.sum ./
RUN go mod download

# Stage 2: build a statically linked binary with debug info stripped
FROM deps AS build
COPY go ./go
COPY main.go .
ENV CGO_ENABLED=0
RUN go build \
      -ldflags="-w -s" \
      -trimpath \
      -o petstore .

# Stage 3: scratch — zero-OS image, only the binary + TLS CA bundle
FROM scratch AS runtime
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /go/src/petstore ./
ENV GIN_MODE=release
USER 65534:65534
EXPOSE 8080/tcp
ENTRYPOINT ["./petstore"]
