# Stage 1: install Composer dependencies
FROM php:8.4-cli-alpine AS deps

RUN apk add --no-cache postgresql-dev zip git && \
    docker-php-ext-install pdo pdo_pgsql opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist

COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev

# Stage 2: php-fpm + nginx runtime image
FROM php:8.4-fpm-alpine AS runtime

RUN apk add --no-cache libpq nginx

# Reuse the extensions compiled in the deps stage instead of rebuilding them
# here. The deps stage uses php:8.4-cli-alpine, but cli and fpm variants of
# the same image tag share the identical PHP build (same Zend API version and
# extension dir), so the .so files are binary-compatible.
COPY --from=deps /usr/local/lib/php/extensions /usr/local/lib/php/extensions
COPY --from=deps /usr/local/etc/php/conf.d /usr/local/etc/php/conf.d

# OPcache tuned for a containerised, read-only web app (written after the
# conf.d copy so it is not overwritten); enable_cli also speeds up the artisan
# cache warm-up commands in the entrypoint. save_comments must stay 1:
# Laravel and several packages rely on docblock reflection at runtime.
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.enable_cli=1'; \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.max_accelerated_files=10000'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.save_comments=1'; \
    } > /usr/local/etc/php/conf.d/opcache.ini

# Larger realpath cache avoids repeated filesystem stat() calls on Laravel's
# deep vendor/ include paths
RUN { \
        echo 'realpath_cache_size=4096k'; \
        echo 'realpath_cache_ttl=600'; \
    } > /usr/local/etc/php/conf.d/99-performance.ini

# Benchmark-friendly logging: stderr only, errors only (Laravel default is debug)
ENV LOG_CHANNEL=stderr LOG_LEVEL=error

# nginx site (replace Alpine's default :80 server) and php-fpm pool sizing
RUN rm -f /etc/nginx/http.d/default.conf
COPY docker/nginx-site.conf /etc/nginx/http.d/petstore.conf
COPY docker/php-fpm-pool.conf /usr/local/etc/php-fpm.d/zzz-petstore.conf

WORKDIR /app

COPY --from=deps /app /app
COPY docker/entrypoint.optimized.sh /entrypoint.sh
# php-fpm workers run as www-data (image default) and need to write compiled
# views/logs; bootstrap/cache is written by the entrypoint's artisan commands.
RUN chmod +x /entrypoint.sh && \
    chown -R www-data:www-data /app/storage /app/bootstrap/cache

# The container runs as root: the nginx and php-fpm masters need root to bind
# and manage /run + /var/lib/nginx, while their workers drop to the unprivileged
# nginx / www-data users respectively. A fully non-root setup would require
# rewiring nginx temp/pid paths and is not worth it for a benchmark image.
EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
