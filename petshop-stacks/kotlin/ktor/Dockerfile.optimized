# Stage 1: build the fat JAR (ktor plugin shadowJar / installDist)
FROM eclipse-temurin:21-jdk AS build

WORKDIR /app

COPY gradlew .
COPY gradle ./gradle
COPY build.gradle.kts settings.gradle gradle.properties ./
RUN ./gradlew dependencies -q 2>/dev/null || true

COPY src ./src
RUN ./gradlew buildFatJar -q

# Stage 2: minimal JRE runtime image
FROM eclipse-temurin:21-jre-alpine AS runtime

RUN addgroup -S ktor && adduser -S ktor -G ktor

WORKDIR /app

# Ktor plugin produces petstore-ktor-all.jar (fat jar); fall back to any jar in /build/libs/
COPY --from=build /app/build/libs/*-all.jar app.jar

USER ktor:ktor

EXPOSE 8080

# Hikari pool sizing: 200 handles up to 500 k6 VUs via queueing, under Postgres max_connections=500
ENV HIKARI_MAXIMUM_POOL_SIZE=200 HIKARI_MINIMUM_IDLE=25

# G1GC with container-aware sizing; ZGC optional for low-latency profiles
ENTRYPOINT ["java", \
  "-XX:InitialRAMPercentage=75.0", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:+UseG1GC", \
  "-XX:MaxGCPauseMillis=100", \
  "-XX:+UseStringDeduplication", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
