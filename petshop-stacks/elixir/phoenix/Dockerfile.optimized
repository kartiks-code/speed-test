# Stage 1: compile and build an OTP release
FROM hexpm/elixir:1.18-erlang-28.3.2-debian-bookworm-20260610 AS build

ENV MIX_ENV=prod

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

# mix.lock* glob: no lockfile is checked in, so COPY must tolerate its absence
COPY mix.exs mix.lock* ./
RUN mix deps.get --only prod

COPY config ./config
COPY lib ./lib

RUN mix compile && mix release

# Stage 2: minimal Debian slim runtime with only the OTP release
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 libncurses6 && \
    rm -rf /var/lib/apt/lists/*

# C.UTF-8 ships with Debian bookworm; Erlang/Elixir need a UTF-8 locale
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN useradd --system --no-create-home phoenix

WORKDIR /app

COPY --from=build /app/_build/prod/rel/petstore ./

USER phoenix

EXPOSE 8080

ENV PHX_SERVER=true

# POOL_SIZE=200: queue up to 500 k6 VUs on 200 DB connections (Postgres max_connections=500).
# ERL_FLAGS: +S 2:2 pins schedulers to the harness CPU quota (--cpus 2; the BEAM
# doesn't read cgroup quotas), and the +sbwt* flags disable scheduler busy-waiting,
# which wastes CPU in CPU-capped containers.
ENV POOL_SIZE=200 \
    ERL_FLAGS="+S 2:2 +sbwt none +sbwtdcpu none +sbwtdio none"

ENTRYPOINT ["/app/bin/petstore"]
CMD ["start"]
