# Database connection — either DATABASE_URL (takes precedence) or individual vars

# Full Npgsql connection string (overrides all POSTGRES_* vars when set)
# DATABASE_URL=Host=localhost;Port=5434;Username=myuser;Password=mypassword;Database=csharp-aspnetcore

# Individual connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=csharp-aspnetcore

# Set to "true" to use an in-memory store (no database required — for testing)
USE_IN_MEMORY_DB=false
