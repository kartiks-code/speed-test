# Copy this file to .env and fill in your values.
# The server reads these at startup.

# Full JDBC URL (takes precedence over individual vars)
# DATABASE_URL=jdbc:postgresql://localhost:5434/kotlin-ktor

# Individual connection settings (used when DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=kotlin-ktor
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
