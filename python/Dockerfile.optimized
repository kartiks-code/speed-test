# Stage 1: install dependencies into an isolated venv
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

COPY requirements.txt* setup.cfg* pyproject.toml* ./
COPY src ./src

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

# Stage 2: minimal runtime — no build tools
FROM python:3.12-slim AS runtime

RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --gid 1001 appuser

COPY --from=builder /venv /venv
ENV PATH="/venv/bin:$PATH"

# Prevent .pyc writes and enable unbuffered stdout for container logs
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app

COPY --chown=appuser:appgroup src ./src

USER appuser

EXPOSE 8080

# 4 workers; tune WEB_CONCURRENCY env var at runtime for your CPU count
CMD ["uvicorn", "petstore.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "--workers", "4", \
     "--no-access-log"]
