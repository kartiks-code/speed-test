{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "app/Repositories"
        ],
        "excludes": [
            "app/Repositories/PostgresPetstoreRepository.php"
        ]
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit",
    "timeout": 10,
    "logs": {
        "text": "infection.log"
    },
    "mutators": {
        "@default": true
    }
}
