# Stage 1: install Composer dependencies
FROM php:8.4-cli-alpine AS deps

RUN apk add --no-cache postgresql-dev zip git && \
    docker-php-ext-install pdo pdo_pgsql opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist

COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev

# Stage 2: minimal runtime image
FROM php:8.4-cli-alpine AS runtime

RUN apk add --no-cache libpq

# Reuse the extensions compiled in the deps stage instead of rebuilding them here
COPY --from=deps /usr/local/lib/php/extensions /usr/local/lib/php/extensions
COPY --from=deps /usr/local/etc/php/conf.d /usr/local/etc/php/conf.d

# OPcache tuned for a containerised, read-only web app (written after the
# conf.d copy so it is not overwritten); enable_cli is required because the
# app runs via `php artisan serve`, a CLI process
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.enable_cli=1'; \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.max_accelerated_files=10000'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.save_comments=0'; \
    } > /usr/local/etc/php/conf.d/opcache.ini

RUN adduser -D -H -s /bin/false -u 1001 laravel

WORKDIR /app

COPY --from=deps /app /app
RUN chown -R laravel:laravel /app/storage /app/bootstrap/cache

USER laravel

EXPOSE 8080

# Note: artisan serve is single-threaded; php-fpm+nginx or Octane would be the next optimization step.
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8080"]
