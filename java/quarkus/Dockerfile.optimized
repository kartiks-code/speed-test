# Stage 1: build the uber-jar
# Uses eclipse-temurin:25-jdk; Foojay toolchain resolver falls back to this JDK.
FROM eclipse-temurin:25-jdk AS build

# Install Gradle wrapper dependencies first for layer caching
WORKDIR /app
COPY gradlew .
COPY gradle ./gradle
COPY build.gradle settings.gradle gradle.properties ./
RUN ./gradlew dependencies -q 2>/dev/null || true

COPY src ./src
RUN ./gradlew build -x test -q && \
    cp build/*-runner.jar app-runner.jar

# Stage 2: minimal JRE runtime on Alpine
FROM eclipse-temurin:25-jre-alpine AS runtime

RUN addgroup -S quarkus && adduser -S quarkus -G quarkus

WORKDIR /app

COPY --from=build /app/app-runner.jar app.jar

USER quarkus

EXPOSE 8080

# Quarkus uber-jar is a fast-jar; G1GC with container-aware heap sizing.
ENTRYPOINT ["java", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:+UseG1GC", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
